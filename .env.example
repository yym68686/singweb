# 管理服务 API 前缀
VITE_API_BASE=/api/v1

# 开发时把 /api 转发到管理服务（vite.config.ts 读这个）
SINGWEB_API_PROXY=http://127.0.0.1:8080

# ---------------------------------------------------------------- 管理服务
# docker compose 和直接 node server/src/index.ts 都认这些

# 监听端口。容器里固定 8080，对外映射由 SINGWEB_PORT 决定
PORT=8080
HOST=0.0.0.0

# 数据库连接串。本地直连用下面这个；docker compose 里会指向 db 服务；
# 云上 fugue 部署时由 --managed-postgres 注入，不用手填
DATABASE_URL=postgres://localhost:5432/singweb

# 托管数据库通常要求 TLS，给 1 打开；证书链不完整时再把 STRICT 关掉
# DATABASE_SSL=1
# DATABASE_SSL_STRICT=1

# 连接池上限
# DATABASE_POOL_MAX=10

# 前端构建产物目录，默认是仓库根的 dist
# STATIC_DIR=/app/dist

# ---------------------------------------------------------------- docker compose

# 宿主机映射出来的端口
# SINGWEB_PORT=8080

# PostgreSQL 密码。留空会用 singweb，仅适合本机；对外提供访问时务必改掉
# POSTGRES_PASSWORD=

# 注意：订阅链接（含 token）不在这里配。它在部署后的数据库里，
# 由网页的「订阅」页面录入，服务端只从库里读、只下发给已接入的设备。
